---
import Base from '../layouts/Base.astro';
import Timeline from '../components/Timeline.astro';
import { getExperience, getProfile, u } from '../../lib/site';
const items = await getExperience();
const p = (await getProfile()).data;
---
<Base title="經歷" description="實習、打工、社團與競賽經歷。">
  <section class="page-head">
    <div data-reveal>
      <p class="kicker">Experience</p>
      <h1 class="page-title">經歷</h1>
      <p class="page-lead">從最近的開始。每一段都寫了我做了什麼、留下什麼成果。</p>
      {p.resume && <p data-reveal><a class="btn" href={u(p.resume)}>下載完整履歷</a></p>}
    </div>
  </section>
  <section class="sec"><Timeline items={items} full /></section>
</Base>
