---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import SectionHead from '../components/SectionHead.astro';
import ProjectList from '../components/ProjectList.astro';
import Timeline from '../components/Timeline.astro';
import PostList from '../components/PostList.astro';
import { getProfile, getProjects, getExperience, getPosts, theme } from '../../lib/site';
const p = (await getProfile()).data;
const projects = await getProjects();
const featured = projects.filter((x) => x.data.featured);
const show = (featured.length ? featured : projects).slice(0, theme.homeProjects ?? 3);
const exp = await getExperience();
const posts = (await getPosts()).slice(0, 3);
const n = (i: number) => (theme.sectionNumbers ? String(i).padStart(2, '0') : undefined);
---
<Base>
  <Hero profile={p} featured={show[0]} expCount={exp.length} />
  {show.length > 0 && (
    <section class="sec">
      <SectionHead num={n(1)} kicker="Selected Work" title="精選作品" href="/projects/" />
      <ProjectList items={show} />
    </section>
  )}
  {exp.length > 0 && (
    <section class="sec">
      <SectionHead num={n(2)} kicker="Experience" title="經歷" href="/experience/" />
      <Timeline items={exp.slice(0, 4)} />
    </section>
  )}
  {posts.length > 0 && (
    <section class="sec">
      <SectionHead num={n(3)} kicker="Writing" title="最近寫的" href="/blog/" />
      <PostList items={posts} />
    </section>
  )}
</Base>
