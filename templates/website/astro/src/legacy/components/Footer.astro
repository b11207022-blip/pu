---
import { getProfile, u } from '../../lib/site';
const p = (await getProfile()).data;
const year = new Date().getFullYear();
const onContact = Astro.url.pathname.endsWith('/contact/');
---
<footer class="site-footer">
  <div class="f-inner">
    {!onContact && <div class="f-cta">
      <p class="f-kicker">Contact</p>
      <p class="f-title">想聊聊合作或實習機會？</p>
      <a class="btn" href={u('/contact/')}>跟我聯絡</a>
    </div>}
    <div class="f-meta">
      <ul class="f-links">
        {p.email && <li><a href={`mailto:${p.email}`}>Email</a></li>}
        {p.links.map((l) => <li><a href={l.url} target="_blank" rel="noopener">{l.label}</a></li>)}
      </ul>
      <p class="f-copy">© {year} {p.name}{p.nameEn ? ` ${p.nameEn}` : ''}</p>
    </div>
  </div>
</footer>
