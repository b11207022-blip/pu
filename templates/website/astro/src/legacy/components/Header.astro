---
import { theme, getProfile, navItems, u, initials } from '../../lib/site';
const p = (await getProfile()).data;
const items = await navItems();
const path = Astro.url.pathname;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const active = (href: string) => {
  const full = base + href;
  return href === '/' ? path === full || path === base + '/' : path.startsWith(full);
};
const style = theme.header; // bar | center | float | side
---
<header class={`site-header h-${style}`}>
  <div class="h-inner">
    <a class="brand" href={u('/')}>
      {theme.brandMark && <span class="brand-mark" aria-hidden="true">{initials(p.name, p.nameEn)}</span>}
      <span class="brand-text">
        <span class="brand-name">{theme.brandUseEn && p.nameEn ? p.nameEn : p.name}</span>
        {style === 'side' && <span class="brand-role">{p.role}</span>}
      </span>
    </a>
    <button class="menu-btn" data-menu aria-expanded="false" aria-controls="site-nav">
      <span class="sr">選單</span><i></i><i></i>
    </button>
    <nav id="site-nav" class="nav" aria-label="主要導覽">
      {items.map((it, i) => (
        <a href={u(it.href)} class:list={['nav-link', { active: active(it.href) }]} aria-current={active(it.href) ? 'page' : undefined}>
          {theme.navNumbers && <span class="nav-num">{String(i + 1).padStart(2, '0')}</span>}
          <span>{theme.navEnglish ? it.en : it.label}</span>
        </a>
      ))}
    </nav>
    {style === 'side' && (
      <div class="side-foot">
        {p.status && <p class="side-status"><span class="dot"></span>{p.status}</p>}
        <ul class="side-links">
          {p.links.slice(0, 4).map((l) => <li><a href={l.url} target="_blank" rel="noopener">{l.label}</a></li>)}
        </ul>
      </div>
    )}
  </div>
</header>
