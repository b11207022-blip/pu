---
// 作品列表：版型由風格決定 grid | list | stack | index
import type { CollectionEntry } from 'astro:content';
import Cover from './Cover.astro';
import Tags from './Tags.astro';
import { theme, u } from '../lib/site';
interface Props { items: CollectionEntry<'projects'>[] }
const { items } = Astro.props;
const v = theme.projects;
const year = (p?: string) => (p ? (p.match(/\d{4}/) || [''])[0] : '');
---
{v === 'grid' && (
  <ul class="pj-grid">
    {items.map((p, i) => (
      <li data-reveal style={`--d:${i}`}>
        <a class="pj-card" href={u(`/projects/${p.id}/`)}>
          <Cover src={p.data.cover} title={p.data.title} index={i} />
          <div class="pj-body">
            <h3>{p.data.title}</h3>
            <p>{p.data.summary}</p>
            <Tags items={p.data.tags.slice(0, 4)} />
          </div>
        </a>
      </li>
    ))}
  </ul>
)}
{v === 'list' && (
  <ul class="pj-list">
    {items.map((p, i) => (
      <li data-reveal style={`--d:${i}`}>
        <a href={u(`/projects/${p.id}/`)}>
          <span class="pj-year">{year(p.data.period)}</span>
          <span class="pj-main"><strong>{p.data.title}</strong><em>{p.data.summary}</em></span>
          <span class="pj-role">{p.data.role}</span>
          <span class="pj-arrow" aria-hidden="true">→</span>
        </a>
      </li>
    ))}
  </ul>
)}
{v === 'stack' && (
  <ul class="pj-stack">
    {items.map((p, i) => (
      <li data-reveal>
        <a href={u(`/projects/${p.id}/`)}>
          <Cover src={p.data.cover} title={p.data.title} index={i} ratio="16 / 10" />
          <div class="pj-body">
            <p class="pj-meta">{String(i + 1).padStart(2, '0')}　{p.data.period}</p>
            <h3>{p.data.title}</h3>
            <p>{p.data.summary}</p>
            {p.data.results[0] && <p class="pj-result">{p.data.results[0]}</p>}
            <Tags items={p.data.tags.slice(0, 4)} />
            <span class="more">看這個作品<span aria-hidden="true">→</span></span>
          </div>
        </a>
      </li>
    ))}
  </ul>
)}
{v === 'index' && (
  <ol class="pj-index">
    {items.map((p, i) => (
      <li data-reveal style={`--d:${i}`}>
        <a href={u(`/projects/${p.id}/`)}>
          <span class="pj-n">{String(i + 1).padStart(2, '0')}</span>
          <span class="pj-t">{p.data.title}</span>
          <span class="pj-s">{p.data.summary}</span>
          <span class="pj-tags">{p.data.tags.slice(0, 3).join(' / ')}</span>
          <span class="pj-year">{year(p.data.period)}</span>
        </a>
      </li>
    ))}
  </ol>
)}
