---
// 首頁主視覺：statement | bento | split | terminal | minimal | cv
import type { CollectionEntry } from 'astro:content';
import Avatar from './Avatar.astro';
import Highlights from './Highlights.astro';
import Cover from './Cover.astro';
import { theme, u } from '../lib/site';
interface Props { profile: CollectionEntry<'profile'>['data']; featured?: CollectionEntry<'projects'>; expCount: number }
const { profile: p, featured, expCount } = Astro.props;
const v = theme.hero;
const skills = p.skills.flatMap((s) => s.items).slice(0, 10);
const email = p.email ? `mailto:${p.email}` : u('/contact/');
---
{v === 'statement' && (
  <section class="hero hero-statement">
    {p.status && <p class="status" data-reveal><span class="dot"></span>{p.status}</p>}
    <h1 class="hero-title" data-reveal>{p.tagline}</h1>
    <div class="hero-foot" data-reveal>
      <p class="hero-intro"><strong>{p.name}{p.nameEn && <span> {p.nameEn}</span>}</strong>　{p.role}。{p.intro}</p>
      <div class="actions">
        <a class="btn" href={u('/projects/')}>看我的作品</a>
        <a class="btn ghost" href={email}>寄信給我</a>
      </div>
    </div>
    <Highlights items={p.highlights} />
  </section>
)}

{v === 'bento' && (
  <section class="hero hero-bento">
    <div class="bento">
      <div class="tile t-intro" data-reveal>
        {p.status && <p class="status"><span class="dot"></span>{p.status}</p>}
        <h1 class="hero-title">{p.tagline}</h1>
        <p class="hero-intro">{p.intro}</p>
        <div class="actions">
          <a class="btn" href={u('/projects/')}>看我的作品</a>
          <a class="btn ghost" href={u('/about/')}>認識我</a>
        </div>
      </div>
      <div class="tile t-me" data-reveal style="--d:1">
        <Avatar src={p.avatar} name={p.name} nameEn={p.nameEn} />
        <p class="t-name">{p.name}</p>
        <p class="t-role">{p.role}</p>
        {p.location && <p class="t-loc">{p.location}</p>}
      </div>
      {p.highlights.slice(0, 2).map((h, i) => (
        <div class="tile t-stat" data-reveal style={`--d:${i + 2}`}><strong>{h.value}</strong><span>{h.label}</span></div>
      ))}
      {featured && (
        <a class="tile t-feature" href={u(`/projects/${featured.id}/`)} data-reveal style="--d:3">
          <Cover src={featured.data.cover} title={featured.data.title} ratio="16 / 9" />
          <div><p class="kicker">精選作品</p><p class="t-ft">{featured.data.title}</p><p class="t-fs">{featured.data.summary}</p></div>
        </a>
      )}
      <div class="tile t-skills" data-reveal style="--d:4">
        <p class="kicker">我會的</p>
        <ul class="tags">{skills.map((s) => <li>{s}</li>)}</ul>
      </div>
      {p.quote && <div class="tile t-quote" data-reveal style="--d:5"><p>「{p.quote}」</p></div>}
      <a class="tile t-contact" href={email} data-reveal style="--d:6">
        <p class="kicker">聯絡</p><p class="t-ft">一起做點什麼</p><span class="arrow" aria-hidden="true">↗</span>
      </a>
    </div>
  </section>
)}

{v === 'split' && (
  <section class="hero hero-split">
    <div class="split-text">
      {p.status && <p class="status" data-reveal><span class="dot"></span>{p.status}</p>}
      <p class="hero-name" data-reveal>{p.name}{p.nameEn && <span>{p.nameEn}</span>}</p>
      <h1 class="hero-title" data-reveal>{p.tagline}</h1>
      <p class="hero-intro" data-reveal>{p.intro}</p>
      <div class="actions" data-reveal>
        <a class="btn" href={u('/projects/')}>看我的作品</a>
        <a class="btn ghost" href={email}>寄信給我</a>
      </div>
    </div>
    <div class="split-art" data-reveal>
      <div class="orb" aria-hidden="true"></div>
      <Avatar src={p.avatar} name={p.name} nameEn={p.nameEn} />
      <p class="split-role">{p.role}</p>
    </div>
    <Highlights items={p.highlights} />
  </section>
)}

{v === 'terminal' && (
  <section class="hero hero-terminal">
    <div class="term" data-reveal>
      <div class="term-bar"><i></i><i></i><i></i><span>{(p.nameEn || 'me').toLowerCase().replace(/\s+/g, '')}@portfolio: ~</span></div>
      <div class="term-body">
        <p class="cmd"><span class="ps">$</span> whoami</p>
        <h1 class="hero-title">{p.name}{p.nameEn && <span class="dim"> / {p.nameEn}</span>}</h1>
        <p class="out">{p.role}</p>
        <p class="cmd"><span class="ps">$</span> cat tagline.txt</p>
        <p class="out big">{p.tagline}</p>
        <p class="out dim">{p.intro}</p>
        {p.status && <><p class="cmd"><span class="ps">$</span> status</p><p class="out ok">● {p.status}</p></>}
        <p class="cmd"><span class="ps">$</span> ls skills/</p>
        <p class="out ls">{skills.map((s) => <span>{s}</span>)}</p>
        <p class="cmd"><span class="ps">$</span> <span class="caret"></span></p>
      </div>
    </div>
    <div class="actions" data-reveal>
      <a class="btn" href={u('/projects/')}>./projects</a>
      <a class="btn ghost" href={email}>./contact</a>
    </div>
    <Highlights items={p.highlights} />
  </section>
)}

{v === 'minimal' && (
  <section class="hero hero-minimal">
    <Avatar src={p.avatar} name={p.name} nameEn={p.nameEn} />
    <h1 class="hero-name" data-reveal>{p.name}{p.nameEn && <span>{p.nameEn}</span>}</h1>
    <p class="hero-role" data-reveal>{p.role}</p>
    <p class="hero-title" data-reveal>{p.tagline}</p>
    <p class="hero-intro" data-reveal>{p.intro}</p>
    {p.status && <p class="status" data-reveal><span class="dot"></span>{p.status}</p>}
    <p class="inline-links" data-reveal>
      {p.email && <a href={`mailto:${p.email}`}>Email</a>}
      {p.links.map((l) => <a href={l.url} target="_blank" rel="noopener">{l.label}</a>)}
    </p>
  </section>
)}

{v === 'cv' && (
  <section class="hero hero-cv">
    <div class="cv-card" data-reveal>
      <Avatar src={p.avatar} name={p.name} nameEn={p.nameEn} />
      <div>
        <h1 class="hero-name">{p.name}{p.nameEn && <span>{p.nameEn}</span>}</h1>
        <p class="hero-role">{p.role}</p>
        <ul class="cv-facts">
          {p.location && <li><span>所在地</span>{p.location}</li>}
          {p.status && <li><span>目前</span>{p.status}</li>}
          {p.email && <li><span>Email</span><a href={`mailto:${p.email}`}>{p.email}</a></li>}
          <li><span>經歷</span>{expCount} 段</li>
        </ul>
        <div class="actions">
          {p.resume && <a class="btn" href={u(p.resume)}>下載履歷</a>}
          <a class:list={['btn', { ghost: !!p.resume }]} href={u('/contact/')}>聯絡我</a>
        </div>
      </div>
    </div>
    <div class="cv-summary" data-reveal>
      <p class="kicker">Summary</p>
      <p class="hero-title">{p.tagline}</p>
      <p class="hero-intro">{p.intro}</p>
      <Highlights items={p.highlights} />
    </div>
  </section>
)}
