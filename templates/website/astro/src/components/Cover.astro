---
// 作品封面：有 cover 就用照片，沒有就用標題產生一張有質感的色塊
import { u } from '../lib/site';
interface Props { src?: string; title: string; index?: number; ratio?: string; eager?: boolean }
const { src, title, index = 0, ratio = '4 / 3', eager = false } = Astro.props;
const word = title.replace(/[^\p{L}\p{N}]/gu, '').slice(0, 2);
---
<div class="cover" style={`aspect-ratio:${ratio};--i:${index}`}>
  {src
    ? <img src={u(src)} alt={title} loading={eager ? 'eager' : 'lazy'} decoding="async" />
    : <div class="cover-ph" aria-hidden="true"><span>{word}</span></div>}
</div>
