---
import { getProfile, navItems, u } from '../../../lib/site';
const p = (await getProfile()).data;
const items = await navItems();
const year = new Date().getFullYear();
const onContact = Astro.url.pathname.startsWith(u('/contact/'));
---
<footer class="foot">
  {!onContact && (
    <section class="foot-cta wrap" data-reveal>
      <p class="foot-cmd"><span class="ps">~</span> <span class="tok-fn">open</span> <span class="tok-str">./contact</span></p>
      <h2 class="foot-title">有想一起做的事？<br />我很樂意聊聊。</h2>
      <div class="foot-actions">
        <a class="btn btn-primary" href={u('/contact/')}>聯絡我 <span aria-hidden="true">→</span></a>
        {p.email && <button class="btn btn-ghost" type="button" data-copy={p.email}><span class="btn-ic" aria-hidden="true">⧉</span>{p.email}</button>}
      </div>
    </section>
  )}
  <div class="foot-grid wrap">
    <div>
      <p class="foot-name">{p.name}{p.nameEn && <span> {p.nameEn}</span>}</p>
      <p class="foot-role">{p.role}</p>
    </div>
    <nav aria-label="頁尾導覽" class="foot-links">
      {items.map((i) => <a href={u(i.href)}>{i.label}</a>)}
    </nav>
    {p.links.length > 0 && <div class="foot-links">{p.links.map((l) => <a href={u(l.url)} target="_blank" rel="noopener">{l.label} ↗</a>)}</div>}
  </div>
  <div class="statusbar">
    <div class="sb-l">
      {p.status && <span class="sb-item sb-ok"><span class="led"></span>{p.status}</span>}
      <span class="sb-item sb-hide">© {year} {p.name}</span>
    </div>
    <div class="sb-r">
      {p.location && <span class="sb-item sb-hide">{p.location}</span>}
      <span class="sb-item sb-hide">UTF-8</span>
      <button class="sb-item sb-btn" type="button" data-palette-open><kbd><span data-mod>⌘</span>K</kbd> 指令面板</button>
    </div>
  </div>
</footer>
