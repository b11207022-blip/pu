---
// Raycast 式：左邊清單、右邊預覽。滑過或聚焦換預覽；手機只顯示清單（含縮圖）
import { img, u } from '../../../lib/site';
import Diff from './Diff.astro';
interface Props { projects: any[]; search?: boolean; title?: string }
const { projects, search = false, title = '~/projects' } = Astro.props;
const tags = [...new Set(projects.flatMap((x) => x.data.tags))];
---
<div class="browser win" data-browser data-window>
  <header class="win-bar">
    <span class="win-lights" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="win-title">{title}</span>
    <span class="win-meta">{projects.length} items</span>
  </header>
  {search && (
    <div class="br-search">
      <span class="ps" aria-hidden="true">›</span>
      <input type="search" placeholder={`篩選作品（試試 ${tags[0] || '關鍵字'}）`} aria-label="篩選作品" data-br-filter autocomplete="off" spellcheck="false" />
      <span class="br-count" data-br-count>{projects.length} / {projects.length}</span>
    </div>
  )}
  <div class="br-panes">
    <ol class="br-list">
      {projects.map((x, i) => {
        const cover = img(x.data.cover);
        return (
          <li data-br-item data-i={i} data-search={`${x.data.title} ${x.data.summary} ${x.data.tags.join(' ')} ${x.id}`.toLowerCase()}>
            <a href={u(`/projects/${x.id}/`)} class="br-row" aria-current={i === 0 ? 'true' : undefined}>
              <span class="br-ic">{String(i + 1).padStart(2, '0')}</span>
              <span class="br-main">
                <span class="br-title">{x.data.title}</span>
                <span class="br-sum">{x.data.summary}</span>
                {x.data.period && <span class="br-period">{x.data.period}</span>}
              </span>
              <span class="br-tags">{x.data.tags.slice(0, 2).map((t: string) => <span class="label">{t}</span>)}</span>
              {cover && <span class="br-thumb"><img src={cover} alt="" loading="lazy" decoding="async" /></span>}
            </a>
          </li>
        );
      })}
      <li class="br-empty" data-br-empty hidden>沒有符合的作品，換個關鍵字試試。</li>
      <li class="br-hint" aria-hidden="true"><span><kbd>↑</kbd><kbd>↓</kbd> 瀏覽</span><span><kbd>↵</kbd> 開啟</span><span class="br-hint-r">滑過看預覽</span></li>
    </ol>
    <div class="br-detail" aria-hidden="true">
      {projects.map((x, i) => {
        const cover = img(x.data.cover);
        return (
          <div class="br-pane" data-pane={i} hidden={i !== 0}>
            {cover ? (
              <div class="br-shot"><img src={cover} alt="" loading={i === 0 ? 'eager' : 'lazy'} decoding="async" /></div>
            ) : (
              <div class="br-card">
                <span class="br-card-id">{x.id}</span>
                <span class="br-card-title">{x.data.title}</span>
                <span class="br-card-sum">{x.data.summary}</span>
                <span class="br-card-tags">{x.data.tags.map((t: string) => <span class="label">{t}</span>)}</span>
              </div>
            )}
            <dl class="br-meta">
              {x.data.period && <div><dt>period</dt><dd>{x.data.period}</dd></div>}
              {x.data.role && <div><dt>role</dt><dd>{x.data.role}</dd></div>}
            </dl>
            {x.data.results.length > 0 && <Diff results={x.data.results.slice(0, 3)} />}
          </div>
        );
      })}
    </div>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-browser]').forEach((br) => {
    const rows = [...br.querySelectorAll<HTMLElement>('[data-br-item]')];
    const panes = [...br.querySelectorAll<HTMLElement>('[data-pane]')];
    const show = (i: number) => {
      panes.forEach((p) => (p.hidden = p.dataset.pane !== String(i)));
      rows.forEach((r) => {
        const a = r.querySelector('a');
        if (!a) return;
        if (r.dataset.i === String(i)) a.setAttribute('aria-current', 'true'); else a.removeAttribute('aria-current');
      });
    };
    rows.forEach((r) => {
      const a = r.querySelector('a')!;
      const i = Number(r.dataset.i);
      a.addEventListener('mouseenter', () => show(i));
      a.addEventListener('focus', () => show(i));
    });
    // 清單內用方向鍵移動
    br.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowDown' && e.key !== 'ArrowUp') return;
      const links = rows.filter((r) => !r.hidden).map((r) => r.querySelector('a')!);
      const at = links.indexOf(document.activeElement as HTMLAnchorElement);
      if (at < 0) return;
      e.preventDefault();
      links[(at + (e.key === 'ArrowDown' ? 1 : -1) + links.length) % links.length].focus();
    });
    const f = br.querySelector<HTMLInputElement>('[data-br-filter]');
    const count = br.querySelector('[data-br-count]');
    const empty = br.querySelector<HTMLElement>('[data-br-empty]');
    f?.addEventListener('input', () => {
      const q = f.value.trim().toLowerCase();
      let n = 0; let first = -1;
      rows.forEach((r) => {
        const ok = !q || (r.dataset.search || '').includes(q);
        r.hidden = !ok;
        if (ok) { n++; if (first < 0) first = Number(r.dataset.i); }
      });
      if (count) count.textContent = `${n} / ${rows.length}`;
      if (empty) empty.hidden = n > 0;
      if (first >= 0) show(first);
    });
  });
</script>
