---
import { getProfile, navItems, u } from '../../../lib/site';
import Mark from './Mark.astro';
interface Props { path?: string }
const { path = '' } = Astro.props;
const p = (await getProfile()).data;
const items = await navItems();
const here = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? here === u('/') : here.startsWith(u(href)));
const handle = (p.nameEn || p.name).toLowerCase().replace(/\s+/g, '-');
---
<header class="menubar">
  <div class="mb-inner">
    <a class="mb-brand" href={u('/')} aria-label={`${p.name} 首頁`}>
      <Mark size={24} />
      <span class="mb-handle">{handle}</span>
      {path && <span class="mb-path">/{path}</span>}
    </a>
    <nav class="mb-nav" aria-label="主要導覽">
      {items.map((i) => (
        <a href={u(i.href)} aria-current={isActive(i.href) ? 'page' : undefined}>{i.en.toLowerCase()}</a>
      ))}
    </nav>
    <button class="mb-k" type="button" data-palette-open aria-label="開啟指令面板（選單）">
      <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><circle cx="7" cy="7" r="4.5" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="m10.5 10.5 3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
      <span class="mb-k-label">跳到…</span>
      <span class="mb-k-mobile">選單</span>
      <kbd><span data-mod>⌘</span>K</kbd>
    </button>
  </div>
</header>
