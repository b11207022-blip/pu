---
import Layout from '../Layout.astro';
import Window from '../components/Window.astro';
import Mark from '../components/Mark.astro';
import { getProfile, img, u } from '../../../lib/site';
import { render } from 'astro:content';

const profile = await getProfile();
const p = profile.data;
const { Content } = await render(profile);
const photos = [p.avatar, ...p.photos].filter(Boolean).filter((v, i, a) => a.indexOf(v) === i).map((s) => ({ src: img(s)!, name: s!.split('/').pop() }));
const yaml: [string, string | undefined][] = [
  ['name', p.name], ['name_en', p.nameEn], ['role', p.role], ['location', p.location], ['status', p.status], ['email', p.email],
];
---
<Layout title="關於" path="about">
  <section class="page-head wrap">
    <p class="crumb" data-intro><span class="ps">~</span> cat about.md</p>
    <h1 class="page-title" data-intro>關於{p.name}</h1>
    {p.quote && <p class="page-lead tok-comment" data-intro>/* {p.quote} */</p>}
  </section>

  <section class="wrap about">
    <div class="about-main">
      <Window title="about.md" meta="Markdown">
        <div class="prose"><Content /></div>
      </Window>
      {p.traits.length > 0 && (
        <div class="traits">
          {p.traits.map((t, i) => (
            <article class="trait" data-reveal>
              <p class="trait-k">## {String(i + 1).padStart(2, '0')}</p>
              <h3>{t.title}</h3>
              <p>{t.text}</p>
            </article>
          ))}
        </div>
      )}
    </div>
    <aside class="about-side">
      {photos.length > 0 ? (
        <Window title={photos[0].name || 'photo'} meta="Preview" class="viewer" flush>
          <img class="viewer-img" src={photos[0].src} alt={`${p.name} 的照片`} decoding="async" />
          {photos.length > 1 && (
            <div class="viewer-strip" style={`grid-template-columns:repeat(${Math.min(photos.length - 1, 3)},1fr)`}>
              {photos.slice(1, 4).map((ph, i) => <img src={ph.src} alt={`${p.name} 的照片 ${i + 2}`} decoding="async" />)}
            </div>
          )}
        </Window>
      ) : (
        <Window title="profile" meta="Card" class="idcard">
          <div class="idcard-in">
            <Mark size={72} />
            <div>
              <p class="idcard-name">{p.name}</p>
              {p.nameEn && <p class="idcard-en">{p.nameEn}</p>}
            </div>
          </div>
        </Window>
      )}
      <Window title="profile.yml" meta="YAML">
        <ol class="code yaml">
          {yaml.filter(([, v]) => v).map(([k, v]) => <li><span class="tok-key">{k}</span><span class="tok-op">:</span> <span class="tok-str">{v}</span></li>)}
          {p.links.length > 0 && <li><span class="tok-key">links</span><span class="tok-op">:</span></li>}
          {p.links.map((l) => <li class="ind"><span class="tok-op">- </span><a class="tok-link" href={u(l.url)} target="_blank" rel="noopener">{l.label}</a></li>)}
        </ol>
      </Window>
      {p.highlights.length > 0 && (
        <dl class="mini-metrics" data-reveal>
          {p.highlights.map((h) => <div><dd>{h.value}</dd><dt>{h.label}</dt></div>)}
        </dl>
      )}
    </aside>
  </section>

  {p.skills.length > 0 && (
    <section class="sec wrap">
      <p class="sec-k" data-reveal>// stack</p>
      <h2 class="sec-title" data-reveal>工具與技能</h2>
      <div class="skill-grid">
        {p.skills.map((g) => (
          <div class="skill" data-reveal>
            <p class="skill-k">{g.group}<span>{g.items.length}</span></p>
            <p class="skill-items">{g.items.map((s) => <span class="label">{s}</span>)}</p>
          </div>
        ))}
      </div>
    </section>
  )}

  {p.interests.length > 0 && (
    <section class="sec wrap">
      <p class="sec-k" data-reveal>// off screen</p>
      <h2 class="sec-title" data-reveal>工作之外</h2>
      <ul class="interests">
        {p.interests.map((s) => {
          const [k, ...v] = s.split(/[：:]/);
          return <li data-reveal><span class="tok-fn">{k}</span>{v.length > 0 && <span>{v.join('：')}</span>}</li>;
        })}
      </ul>
    </section>
  )}
</Layout>
