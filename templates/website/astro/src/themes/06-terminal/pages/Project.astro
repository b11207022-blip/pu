---
import Layout from '../Layout.astro';
import Window from '../components/Window.astro';
import Diff from '../components/Diff.astro';
import { img, u } from '../../../lib/site';
import { render } from 'astro:content';

const { entry, index = 0, total = 1, prev, next } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const cover = img(d.cover);
const file = d.cover ? d.cover.split('/').pop() : '';
---
<Layout title={d.title} description={d.summary} image={d.cover || undefined} path={`projects/${entry.id}`}>
  <article class="wrap pr">
    <header class="pr-head">
      <p class="crumb" data-intro><a href={u('/projects/')}>projects</a> <span class="tok-dim">/</span> {entry.id} <span class="tok-dim">· {String(index + 1).padStart(2, '0')} of {String(total).padStart(2, '0')}</span></p>
      <h1 class="pr-title" data-intro>{d.title}</h1>
      <div class="pr-badges" data-intro>
        <span class="badge-ok"><svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M3 8.5 6.5 12 13 4.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>Shipped</span>
        {d.period && <span class="tok-dim">{d.period}</span>}
      </div>
    </header>

    <div class="pr-grid">
      <div class="pr-main">
        {cover && (
          <Window title={file || 'preview'} meta="Preview" class="shot" flush>
            <img src={cover} alt={`${d.title} 畫面`} decoding="async" />
          </Window>
        )}
        {d.results.length > 0 && (
          <Window title="results.diff" meta={`+${d.results.length} −0`} flush>
            <Diff results={d.results} file={entry.id} />
          </Window>
        )}
        <Window title="README.md" meta="Markdown">
          <div class="prose"><Content /></div>
        </Window>
        {d.gallery.length > 0 && (
          <div class="pr-gallery">
            {d.gallery.map((g: any) => (
              <figure class="g-item" data-reveal>
                <div class="g-frame"><img src={img(g.src)} alt={g.caption || d.title} loading="lazy" decoding="async" /></div>
                {g.caption && <figcaption><span class="tok-comment">// </span>{g.caption}</figcaption>}
              </figure>
            ))}
          </div>
        )}
      </div>
      <aside class="pr-side">
        <div class="side-box" data-reveal>
          <p class="side-k">About</p>
          <p class="side-sum">{d.summary}</p>
          {d.links.length > 0 && (
            <ul class="side-links">
              {d.links.map((l: any) => <li><a href={u(l.url)} target="_blank" rel="noopener"><span class="tok-fn">↗</span> {l.label}</a></li>)}
            </ul>
          )}
        </div>
        {d.tags.length > 0 && (
          <div class="side-box" data-reveal>
            <p class="side-k">Stack</p>
            <p class="side-tags">{d.tags.map((t: string) => <span class="label label-accent">{t}</span>)}</p>
          </div>
        )}
        <dl class="side-box side-dl" data-reveal>
          {d.role && <div><dt>Role</dt><dd>{d.role}</dd></div>}
          {d.period && <div><dt>Period</dt><dd>{d.period}</dd></div>}
          <div><dt>Status</dt><dd><span class="led"></span> 已完成</dd></div>
        </dl>
      </aside>
    </div>

    {(prev || next) && (
      <nav class="pager" aria-label="其他作品">
        {prev ? <a href={u(`/projects/${prev.id}/`)} class="pg"><span class="pg-k">← prev</span><span class="pg-t">{prev.data.title}</span></a> : <span></span>}
        {next && next.id !== entry.id ? <a href={u(`/projects/${next.id}/`)} class="pg pg-next"><span class="pg-k">next →</span><span class="pg-t">{next.data.title}</span></a> : <span></span>}
      </nav>
    )}
  </article>
</Layout>
