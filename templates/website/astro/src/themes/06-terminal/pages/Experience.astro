---
import Layout from '../Layout.astro';
import { getExperience, u } from '../../../lib/site';
import { hash } from '../lib';
const exp = await getExperience();
---
<Layout title="經歷" path="experience">
  <section class="page-head wrap">
    <p class="crumb" data-intro><span class="ps">~</span> git log <span class="tok-dim">--graph --all</span></p>
    <h1 class="page-title" data-intro>經歷</h1>
    <p class="page-lead" data-intro>實習、打工、社團和比賽。每一段都是一個 commit：做了什麼、留下什麼。</p>
  </section>
  <section class="wrap">
    {exp.length > 0 ? (
      <div class="graph">
        <span class="graph-rail" aria-hidden="true"><span data-rail></span></span>
        <ol class="graph-list">
        {exp.map((x, i) => (
          <li class="commit" data-reveal>
            <span class="commit-dot" aria-hidden="true"></span>
            <div class="commit-head">
              <span class="tok-amber">commit {hash(x.id)}</span>
              {i === 0 && <span class="label label-accent">HEAD → main</span>}
              {x.data.type && <span class="label">{x.data.type}</span>}
              <span class="commit-date">{x.data.period}</span>
            </div>
            <div class="commit-card">
              <h2>{x.data.title}</h2>
              <p class="commit-org">{x.data.org}</p>
              <p class="commit-sum">{x.data.summary}</p>
              {x.data.points.length > 0 && <ul class="commit-pts">{x.data.points.map((pt) => <li>{pt}</li>)}</ul>}
            </div>
          </li>
        ))}
        </ol>
      </div>
    ) : (
      <div class="win empty"><p class="empty-t">還沒有 commit</p><p>課堂專題、社團、打工都算經歷，整理好就會出現在這裡。</p><a class="link" href={u('/projects/')}>先看作品 →</a></div>
    )}
  </section>
</Layout>
