---
// 開發者終端：全站外框。選單列、⌘K 指令面板、狀態列、全站動畫。
import Seo from '../../shared/Seo.astro';
import MenuBar from './components/MenuBar.astro';
import Palette from './components/Palette.astro';
import StatusBar from './components/StatusBar.astro';
import { config } from '../../lib/site';
import './terminal.css';

interface Props { title?: string; description?: string; image?: string; path?: string }
const { title, description, image, path = '' } = Astro.props;
---
<!doctype html>
<html lang={config.lang || 'zh-Hant'}>
  <head>
    <Seo title={title} description={description} image={image} />
  </head>
  <body>
    <a class="skip" href="#main">跳到主要內容</a>
    <div class="backdrop" aria-hidden="true"></div>
    <MenuBar path={path} />
    <main id="main">
      <slot />
    </main>
    <StatusBar />
    <Palette />
    <div class="toast" role="status" aria-live="polite" data-toast></div>
  </body>
</html>

<script>
  import { gsap, ScrollTrigger, still, onReady } from '../../lib/motion';

  if (still) document.documentElement.classList.add('is-still');
  const isMac = /Mac|iPhone|iPad/.test(navigator.platform || navigator.userAgent);
  if (!isMac) document.querySelectorAll('[data-mod]').forEach((el) => (el.textContent = 'Ctrl'));

  // 小提示
  const toast = document.querySelector<HTMLElement>('[data-toast]')!;
  let tt: number | undefined;
  const say = (msg: string) => {
    toast.textContent = msg;
    toast.classList.add('on');
    clearTimeout(tt);
    tt = window.setTimeout(() => toast.classList.remove('on'), 1800);
  };
  (window as any).__say = say;

  // 複製
  const copy = async (text: string) => {
    try { await navigator.clipboard.writeText(text); say(`已複製 ${text}`); }
    catch { say('沒辦法複製，請手動選取'); }
  };
  document.querySelectorAll<HTMLElement>('[data-copy]').forEach((b) => b.addEventListener('click', () => copy(b.dataset.copy || '')));

  // ───── ⌘K 指令面板 ─────
  const pal = document.querySelector<HTMLElement>('[data-palette]')!;
  const input = pal.querySelector<HTMLInputElement>('input')!;
  const items = [...pal.querySelectorAll<HTMLElement>('[data-cmd]')];
  const groups = [...pal.querySelectorAll<HTMLElement>('[data-group]')];
  const empty = pal.querySelector<HTMLElement>('[data-empty]')!;
  let active = 0;
  let lastFocus: Element | null = null;
  const visible = () => items.filter((i) => !i.hidden);
  const mark = (n: number) => {
    const v = visible();
    if (!v.length) return;
    active = (n + v.length) % v.length;
    v.forEach((el, i) => el.setAttribute('aria-selected', String(i === active)));
    v[active].scrollIntoView({ block: 'nearest' });
    input.setAttribute('aria-activedescendant', v[active].id);
  };
  const filter = () => {
    const q = input.value.trim().toLowerCase();
    items.forEach((el) => { el.hidden = !!q && !(el.dataset.search || '').includes(q); });
    groups.forEach((g) => { g.hidden = ![...g.querySelectorAll<HTMLElement>('[data-cmd]')].some((i) => !i.hidden); });
    empty.hidden = visible().length > 0;
    mark(0);
  };
  const open = () => {
    if (!pal.hidden) return;
    lastFocus = document.activeElement;
    pal.hidden = false;
    document.documentElement.classList.add('pal-open');
    input.value = '';
    filter();
    input.focus();
    if (!still) {
      gsap.fromTo(pal.querySelector('.pal-box'), { y: -10, scale: 0.98, opacity: 0 }, { y: 0, scale: 1, opacity: 1, duration: 0.22, ease: 'power3.out' });
      gsap.fromTo(pal.querySelector('.pal-scrim'), { opacity: 0 }, { opacity: 1, duration: 0.2 });
    }
  };
  const close = () => {
    if (pal.hidden) return;
    pal.hidden = true;
    document.documentElement.classList.remove('pal-open');
    (lastFocus as HTMLElement | null)?.focus?.();
  };
  const run = (el: HTMLElement) => {
    const { href, copy: text, ext } = el.dataset;
    close();
    if (text) copy(text);
    else if (href && ext) window.open(href, '_blank', 'noopener');
    else if (href) location.href = href;
  };
  document.querySelectorAll('[data-palette-open]').forEach((b) => b.addEventListener('click', open));
  pal.querySelector('.pal-scrim')!.addEventListener('click', close);
  input.addEventListener('input', filter);
  items.forEach((el) => {
    el.addEventListener('click', () => run(el));
    el.addEventListener('mousemove', () => { const i = visible().indexOf(el); if (i !== active) mark(i); });
  });
  document.addEventListener('keydown', (e) => {
    const k = e.key.toLowerCase();
    if ((e.metaKey || e.ctrlKey) && k === 'k') { e.preventDefault(); pal.hidden ? open() : close(); return; }
    if (pal.hidden) {
      const t = e.target as HTMLElement;
      if (k === '/' && !/input|textarea/i.test(t.tagName)) { e.preventDefault(); open(); }
      return;
    }
    if (k === 'escape') { e.preventDefault(); close(); }
    else if (k === 'arrowdown') { e.preventDefault(); mark(active + 1); }
    else if (k === 'arrowup') { e.preventDefault(); mark(active - 1); }
    else if (k === 'enter') { e.preventDefault(); const v = visible()[active]; if (v) run(v); }
    else if (k === 'tab') { e.preventDefault(); mark(active + (e.shiftKey ? -1 : 1)); }
  });

  // ───── 動畫：快、乾脆 ─────
  onReady(() => {
    gsap.from('.menubar', { y: -12, opacity: 0, duration: 0.45, ease: 'power3.out' });
    gsap.from('[data-intro]', { y: 14, opacity: 0, duration: 0.55, ease: 'power3.out', stagger: 0.06, delay: 0.08 });
    ScrollTrigger.batch('[data-reveal]', {
      start: 'top 90%', once: true,
      onEnter: (els) => gsap.from(els, { y: 16, opacity: 0, duration: 0.5, ease: 'power3.out', stagger: 0.05, overwrite: true }),
    });
    // 視窗開啟：從 98% 彈出
    ScrollTrigger.batch('[data-window]', {
      start: 'top 92%', once: true,
      onEnter: (els) => gsap.from(els, { scale: 0.98, y: 18, opacity: 0, duration: 0.5, ease: 'power3.out', stagger: 0.06, overwrite: true }),
    });
    // 差異行一行一行跑出來
    document.querySelectorAll('[data-diff]').forEach((el) => {
      gsap.from(el.querySelectorAll('.d-line'), {
        x: -8, opacity: 0, duration: 0.3, ease: 'power2.out', stagger: 0.07,
        scrollTrigger: { trigger: el, start: 'top 85%', once: true },
      });
    });
    // 時間軸線條
    document.querySelectorAll('[data-rail]').forEach((el) => {
      gsap.from(el, { scaleY: 0, ease: 'none', scrollTrigger: { trigger: el.parentElement, start: 'top 75%', end: 'bottom 75%', scrub: true } });
    });
  });
</script>
