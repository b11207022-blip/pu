---
// 沒有大頭照時的識別：細線光環＋縮寫，有照片就放照片
import { getProfile, img, initials } from '../../../lib/site';
interface Props { size?: 'sm' | 'md' | 'lg'; photo?: boolean }
const { size = 'md', photo = false } = Astro.props;
const p = (await getProfile()).data;
const src = photo ? img(p.avatar) : undefined;
---
<span class:list={['mono-mark', `mm-${size}`, src && 'has-photo']} aria-hidden="true">
  {src ? <img src={src} alt="" loading="eager" /> : <span class="mm-text">{initials(p.name, p.nameEn)}</span>}
</span>
