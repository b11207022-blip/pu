---
// 沒有截圖時，裝置畫面改成「作品規格」：標題、一句話、成果數字、技術。
interface Props { title: string; summary: string; results: string[]; tags: string[]; period?: string; index?: number; compact?: boolean }
const { title, summary, results, tags, period, index = 0, compact = false } = Astro.props;
const top = results.slice(0, compact ? 1 : 3);
const num = (s: string) => { const all = s.match(/\d[\d,.]*(?:\s*[–~-]\s*\d[\d,.]*)?\s*(?:%|倍|位|人|筆|本|小時|分鐘|秒|步|場|名|次|個)/g); return all ? (/降到|減到|提高到|降至|升到|變成/.test(s) ? all[all.length - 1] : all[0]) : undefined; };
---
{compact ? (
  <div class="spec spec-compact">
    <div class="spec-head">
      <span class="spec-no">{results[0] ? 'Key result' : 'Overview'}</span>
      <span class="spec-period">{results.length > 1 ? `+${results.length - 1} more` : ''}</span>
    </div>
    {(() => {
      const r = results[0];
      const n = r ? num(r) : undefined;
      return r
        ? <p class="kpi">{n && <strong class="kpi-n">{n}</strong>}<span class="kpi-t">{r}</span></p>
        : <p class="kpi"><span class="kpi-t kpi-sum">{summary}</span></p>;
    })()}
  </div>
) : (
<div class="spec">
  <div class="spec-head">
    <span class="spec-no">{String(index + 1).padStart(2, '0')}</span>
    {period && <span class="spec-period">{period}</span>}
  </div>
  <div class="spec-main">
    <p class="spec-title">{title}</p>
    <p class="spec-sum">{summary}</p>
    {tags.length > 0 && <p class="spec-tags">{tags.map((t) => <span>{t}</span>)}</p>}
  </div>
  {top.length > 0 && (
    <ul class="spec-results">
      {top.map((r) => {
        const n = num(r);
        return <li>{n && <strong>{n}</strong>}<span>{r}</span></li>;
      })}
    </ul>
  )}
</div>
)}
