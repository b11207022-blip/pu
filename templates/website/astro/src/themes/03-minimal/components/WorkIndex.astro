---
// 大字作品索引：滑鼠移過一列，那個作品的截圖會跟著游標浮出來；手機直接顯示縮圖
import { u, img } from '../../../lib/site';
import Arrow from './Arrow.astro';
interface Props { items: any[]; full?: boolean }
const { items, full = false } = Astro.props;
const year = (s?: string) => (s ? (s.match(/\d{4}/) || [''])[0] : '');
---
<div class="idx-wrap">
  <ol class:list={['idx', { 'idx-full': full }]} data-peek>
    {items.map((x, i) => (
      <li class="idx-row" data-peek-i={i}>
        <a href={u(`/projects/${x.id}/`)}>
          <span class="idx-n">{String(i + 1).padStart(2, '0')}</span>
          {img(x.data.cover) && <span class="idx-thumb"><img src={img(x.data.cover)} alt="" loading="lazy" decoding="async" /></span>}
          <span class="idx-main">
            <span class="idx-title">{x.data.title}</span>
            {full && <span class="idx-sum">{x.data.summary}</span>}
          </span>
          <span class="idx-tags">{x.data.tags.slice(0, 3).join(' · ')}</span>
          <span class="idx-year">{year(x.data.period)}</span>
          <Arrow class="idx-arrow" />
        </a>
      </li>
    ))}
  </ol>
  <div class="peek" aria-hidden="true">
    {items.map((x, i) => (
      <div class="peek-item">
        {img(x.data.cover)
          ? <img src={img(x.data.cover)} alt="" loading="lazy" decoding="async" />
          : <div class="peek-txt"><span class="label">{String(i + 1).padStart(2, '0')} — {x.data.tags.slice(0, 2).join(' · ')}</span><p>{x.data.summary}</p>{x.data.results[0] && <p class="peek-res">{x.data.results[0]}</p>}</div>}
      </div>
    ))}
  </div>
</div>
