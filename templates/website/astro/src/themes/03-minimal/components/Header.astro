---
import { getProfile, navItems, u } from '../../../lib/site';
const p = (await getProfile()).data;
const items = await navItems();
const path = Astro.url.pathname;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const active = (href: string) => (href === '/' ? path === base + '/' || path === base : path.startsWith(base + href));
---
<header class="hd" data-hd>
  <a class="hd-brand" href={u('/')} aria-label="回首頁">
    <span class="hd-name">{p.name}</span>
    {p.nameEn && <span class="hd-en">{p.nameEn}</span>}
  </a>
  <nav class="hd-nav" aria-label="主要導覽">
    {items.map((it) => (
      <a href={u(it.href)} class:list={['hd-link', { on: active(it.href) }]} aria-current={active(it.href) ? 'page' : undefined}>
        <span class="hd-zh">{it.label}</span><span class="hd-link-en">{it.en}</span>
      </a>
    ))}
  </nav>
  <button class="hd-menu" type="button" data-menu aria-expanded="false" aria-controls="menu">
    <span class="hd-menu-t">Menu</span><i aria-hidden="true"></i>
  </button>
</header>
<div class="menu" id="menu">
  <nav class="menu-nav" aria-label="手機選單">
    {items.map((it, i) => (
      <a href={u(it.href)} class:list={['menu-link', { on: active(it.href) }]}>
        <span class="menu-n">{String(i + 1).padStart(2, '0')}</span>
        <span class="menu-zh">{it.label}</span>
        <span class="menu-en">{it.en}</span>
      </a>
    ))}
  </nav>
  <div class="menu-foot">
    {p.status && <p class="label">{p.status}</p>}
    {p.email && <a class="menu-mail" href={`mailto:${p.email}`}>{p.email}</a>}
  </div>
</div>
