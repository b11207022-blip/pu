---
import Layout from '../Layout.astro';
import Arrow from '../components/Arrow.astro';
import Phrase from '../components/Phrase.astro';
import { u, img, fmtDate, readMinutes } from '../../../lib/site';
import { render } from 'astro:content';
const { entry, prev, next } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
---
<Layout title={d.title} description={d.summary} image={d.cover} page="post">
  <article class="post">
    <header class="ph post-head wrap">
      <div class="ph-top" data-fade>
        <a class="label lnk" href={u('/blog/')}><Arrow dir="left" /> Journal</a>
        <span class="label muted">{fmtDate(d.date)} · {readMinutes(entry.body)} min read</span>
      </div>
      <h1 class="post-title" data-lines><Phrase text={d.title} /></h1>
      <p class="post-sum" data-fade>{d.summary}</p>
      {d.tags.length > 0 && <p class="label muted post-tags" data-fade>{d.tags.join(' · ')}</p>}
    </header>
    {d.cover && <figure class="cs-cover wrap"><div class="cs-cover-in" data-img><img src={img(d.cover)} alt="" /></div></figure>}
    <div class="wrap"><div class="prose post-body" data-fade><Content /></div></div>
    {(prev || next) && (
      <nav class="pager wrap" aria-label="其他文章">
        {prev ? <a class="pager-a" href={u(`/blog/${prev.id}/`)}><span class="label muted">Newer</span><span>{prev.data.title}</span></a> : <span></span>}
        {next ? <a class="pager-a pager-next" href={u(`/blog/${next.id}/`)}><span class="label muted">Older</span><span>{next.data.title}</span></a> : <span></span>}
      </nav>
    )}
  </article>
</Layout>
