---
import Layout from '../Layout.astro';
import Arrow from '../components/Arrow.astro';
import Phrase from '../components/Phrase.astro';
import { u, img } from '../../../lib/site';
import { render } from 'astro:content';
const { entry, index = 0, total = 1, next } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const nn = (n: number) => String(n).padStart(2, '0');
const many = d.gallery.length;
---
<Layout title={d.title} description={d.summary} image={d.cover} page="project" cta={!next}>
  <article class="cs">
    <header class="ph cs-head wrap">
      <div class="ph-top" data-fade>
        <a class="label lnk" href={u('/projects/')}><Arrow dir="left" /> Index</a>
        <span class="label muted">{nn(index + 1)} / {nn(total)}</span>
      </div>
      <h1 class="ph-title cs-title" data-lines>{d.title}</h1>
      <div class="cs-meta">
        <p class="cs-sum" data-fade><Phrase text={d.summary} /></p>
        <dl class="facts facts-grid" data-fade>
          {d.role && <div><dt>Role</dt><dd>{d.role}</dd></div>}
          {d.period && <div><dt>Period</dt><dd>{d.period}</dd></div>}
          {d.tags.length > 0 && <div><dt>Tools</dt><dd>{d.tags.join(' · ')}</dd></div>}
          {d.links.length > 0 && <div><dt>Links</dt><dd class="dd-links">{d.links.map((l) => <a class="lnk" href={u(l.url)} target="_blank" rel="noopener">{l.label} <Arrow dir="up" /></a>)}</dd></div>}
        </dl>
      </div>
    </header>

    {d.cover && (
      <figure class="cs-cover wrap"><div class="cs-cover-in" data-img><img src={img(d.cover)} alt={`${d.title} 畫面`} fetchpriority="high" /></div></figure>
    )}

    {d.results.length > 0 && (
      <section class="sec wrap cs-results">
        <header class="sec-head"><span class="label">Outcomes</span><span class="label muted">成果</span></header>
        <ol class="results" data-stagger>
          {d.results.map((r, i) => <li><span class="label muted">{String.fromCharCode(97 + i)}.</span><p>{r}</p></li>)}
        </ol>
      </section>
    )}

    <section class="sec wrap cs-body">
      <div class="prose prose-split" data-fade><Content /></div>
    </section>

    {many > 0 && (
      <section class="sec wrap">
        <header class="sec-head"><span class="label">Gallery</span><span class="label muted">({nn(many)})</span></header>
        <div class:list={['gal', `gal-${Math.min(many, 3)}`]}>
          {d.gallery.map((g) => (
            <figure class="gal-item">
              <div class="gal-frame" data-img><img src={img(g.src)} alt={g.caption || d.title} loading="lazy" decoding="async" /></div>
              {g.caption && <figcaption>{g.caption}</figcaption>}
            </figure>
          ))}
        </div>
      </section>
    )}

    {next && (
      <a class="next wrap" href={u(`/projects/${next.id}/`)}>
        <span class="label">Next — 下一個作品</span>
        <span class="next-title"><span>{next.data.title}</span><Arrow class="next-arrow" /></span>
        <span class="next-sum muted">{next.data.summary}</span>
      </a>
    )}
  </article>
</Layout>
