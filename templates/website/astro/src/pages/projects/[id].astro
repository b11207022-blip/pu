---
import Base from '../../layouts/Base.astro';
import Cover from '../../components/Cover.astro';
import Tags from '../../components/Tags.astro';
import { getProjects, u } from '../../lib/site';
import { render } from 'astro:content';

export async function getStaticPaths() {
  const all = await getProjects();
  return all.map((entry, i) => ({ params: { id: entry.id }, props: { entry, prev: all[i - 1], next: all[i + 1], index: i } }));
}
const { entry, prev, next, index } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
---
<Base title={d.title} description={d.summary}>
  <article class="detail">
    <header class="page-head detail-head">
      <div data-reveal>
        <a class="back" href={u('/projects/')}>← 所有作品</a>
        <h1 class="page-title">{d.title}</h1>
        <p class="page-lead">{d.summary}</p>
      </div>
      <dl class="meta" data-reveal>
        {d.role && <div><dt>我負責</dt><dd>{d.role}</dd></div>}
        {d.period && <div><dt>期間</dt><dd>{d.period}</dd></div>}
        {d.tags.length > 0 && <div><dt>技術</dt><dd><Tags items={d.tags} /></dd></div>}
        {d.links.length > 0 && <div><dt>連結</dt><dd class="meta-links">{d.links.map((l) => <a href={u(l.url)} target="_blank" rel="noopener">{l.label} ↗</a>)}</dd></div>}
      </dl>
    </header>
    <div data-reveal><Cover src={d.cover} title={d.title} index={index} ratio="21 / 9" eager /></div>
    <div class="detail-body">
      {d.results.length > 0 && (
        <aside class="results" data-reveal>
          <p class="kicker">成果</p>
          <ul>{d.results.map((r) => <li>{r}</li>)}</ul>
        </aside>
      )}
      <div class="prose" data-reveal><Content /></div>
    </div>
    <nav class="pager" aria-label="其他作品">
      {prev ? <a href={u(`/projects/${prev.id}/`)}><span>上一個</span>{prev.data.title}</a> : <span></span>}
      {next ? <a class="next" href={u(`/projects/${next.id}/`)}><span>下一個</span>{next.data.title}</a> : <span></span>}
    </nav>
  </article>
</Base>
