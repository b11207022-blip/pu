---
import Base from '../layouts/Base.astro';
import Avatar from '../components/Avatar.astro';
import SectionHead from '../components/SectionHead.astro';
import { getProfile, theme } from '../lib/site';
import { render } from 'astro:content';
const entry = await getProfile();
const p = entry.data;
const { Content } = await render(entry);
const n = (i: number) => (theme.sectionNumbers ? String(i).padStart(2, '0') : undefined);
---
<Base title="關於我">
  <section class="page-head about-head">
    <div data-reveal>
      <p class="kicker">About</p>
      <h1 class="page-title">{p.name}{p.nameEn && <span class="page-sub-en">{p.nameEn}</span>}</h1>
      <p class="page-lead">{p.role}{p.location && `｜${p.location}`}</p>
    </div>
    <div data-reveal><Avatar src={p.avatar} name={p.name} nameEn={p.nameEn} size="clamp(120px,18vw,200px)" /></div>
  </section>

  <section class="sec about-story">
    <SectionHead num={n(1)} kicker="Story" title="我的故事" />
    <div class="prose" data-reveal><Content /></div>
  </section>

  {p.traits.length > 0 && (
    <section class="sec">
      <SectionHead num={n(2)} kicker="How I Work" title="我做事的方式" />
      <ul class="traits">
        {p.traits.map((t, i) => <li data-reveal style={`--d:${i}`}><h3>{t.title}</h3><p>{t.text}</p></li>)}
      </ul>
    </section>
  )}

  {p.skills.length > 0 && (
    <section class="sec">
      <SectionHead num={n(3)} kicker="Skills" title="技能與證照" />
      <div class="skills">
        {p.skills.map((g, i) => (
          <div class="skill-group" data-reveal style={`--d:${i}`}>
            <h3>{g.group}</h3>
            <ul class="tags">{g.items.map((s) => <li>{s}</li>)}</ul>
          </div>
        ))}
      </div>
    </section>
  )}

  {(p.interests.length > 0 || p.quote) && (
    <section class="sec">
      <SectionHead num={n(4)} kicker="Beyond Work" title="工作以外" />
      {p.interests.length > 0 && <ul class="interests" data-reveal>{p.interests.map((s) => <li>{s}</li>)}</ul>}
      {p.quote && <blockquote class="big-quote" data-reveal>「{p.quote}」</blockquote>}
    </section>
  )}
</Base>
