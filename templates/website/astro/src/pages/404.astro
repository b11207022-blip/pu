---
import Base from '../layouts/Base.astro';
import { u } from '../lib/site';
---
<Base title="找不到頁面">
  <section class="page-head">
    <div>
      <p class="kicker">404</p>
      <h1 class="page-title">這一頁不存在</h1>
      <p class="page-lead">可能網址打錯了，或是頁面被搬走了。</p>
      <p><a class="btn" href={u('/')}>回首頁</a></p>
    </div>
  </section>
</Base>
