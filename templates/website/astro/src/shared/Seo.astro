---
// <head> 共用的部分：標題、描述、社群分享、字型、主色。風格的 Layout 在 <head> 裡放 <Seo />。
import { config, theme, getProfile, u } from '../lib/site';
interface Props { title?: string; description?: string; image?: string }
const { title, description, image } = Astro.props;
const p = (await getProfile()).data;
const pageTitle = title ? `${title}｜${p.name}` : `${p.name}｜${p.role}`;
const desc = description || p.intro;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const og = image || p.avatar;
const ogUrl = og && Astro.site ? new URL(u(og), Astro.site).href : og ? u(og) : undefined;
const accent = config.accent ? `:root{--accent:${config.accent}}` : '';
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>{pageTitle}</title>
<meta name="description" content={desc} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={desc} />
<meta property="og:type" content="website" />
{ogUrl && <meta property="og:image" content={ogUrl} />}
<meta name="twitter:card" content="summary_large_image" />
{canonical && <link rel="canonical" href={canonical} />}
<meta name="theme-color" content={theme.themeColor} />
<link rel="icon" href={u('/favicon.svg')} type="image/svg+xml" />
{theme.fonts && <link rel="preconnect" href="https://fonts.googleapis.com" />}
{theme.fonts && <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />}
{theme.fonts && <link rel="stylesheet" href={theme.fonts} />}
{accent && <style set:html={accent} />}
